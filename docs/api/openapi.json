            "name": "state",
            "required": false,
            "schema": {}
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {}
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the frontend home, or to a login error URL. No JSON envelope."
