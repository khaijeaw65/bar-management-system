            "type": "string"
          },
          "data": {
            "enum": [
              null
            ],
            "nullable": true,
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "status": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "status",
          "code",
          "message",
          "data"
        ],
        "type": "object"
      },
      "ApiSuccessEnvelope": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              ""
            ],
            "type": "string"
          },
          "data": {},
          "message": {
            "enum": [
              "success"
            ],
            "type": "string"
          },
          "status": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "status",
          "code",
          "message",
          "data"
        ],
        "type": "object"
      }
    },
