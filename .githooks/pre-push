#!/usr/bin/env sh
# field-kit: pre-push hook (delegates to ops/gates/pre-push.sh)
# Skips gates only when every pushed commit touches docs/** only.
# Emergency skip: `git push --no-verify` — disclose it in the handoff.
set -e

ZERO=0000000000000000000000000000000000000000
NEEDS_GATES=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  if [ "$REMOTE_REF" = "refs/heads/main" ]; then
    if [ "$REMOTE_SHA" = "$ZERO" ] && [ "$LOCAL_SHA" != "$ZERO" ]; then
      echo "[field-kit pre-push] creating main on a new remote — allowed once."; continue
    fi
    echo "❌ [field-kit] push to main blocked — open a PR (pr-review merges)."; exit 1
  fi
  [ "$LOCAL_SHA" = "$ZERO" ] && continue            # branch delete
  if [ "$REMOTE_SHA" = "$ZERO" ]; then              # new remote branch → compare with main
    BASE=$(git merge-base "$LOCAL_SHA" origin/main 2>/dev/null || git merge-base "$LOCAL_SHA" main 2>/dev/null || true)
  else
    BASE="$REMOTE_SHA"
  fi
  if [ -z "$BASE" ]; then NEEDS_GATES=1; continue; fi
  if git diff --name-only "$BASE" "$LOCAL_SHA" | grep -qv '^docs/'; then
    NEEDS_GATES=1
  fi
done

if [ "$NEEDS_GATES" = "0" ]; then
  echo "[field-kit pre-push] docs-only push (or creating main) — gates skipped."
  exit 0
fi

if [ -f "ops/gates/pre-push.sh" ]; then
  sh ops/gates/pre-push.sh
fi
