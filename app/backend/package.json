{
  "name": "@bar/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ && node scripts/check-class-files.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:create": "node ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "nest build && node --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d dist/providers/database/data-source.js",
    "migration:run": "nest build && node --env-file=.env ./node_modules/typeorm/cli.js migration:run -d dist/providers/database/data-source.js",
    "migration:revert": "nest build && node --env-file=.env ./node_modules/typeorm/cli.js migration:revert -d dist/providers/database/data-source.js",
    "seed:staff": "nest build && node --env-file=.env ./dist/cli/seed-staff.js",
    "seed:venue": "nest build && node --env-file=.env ./dist/cli/seed-venue-main.js",
    "seed:menu": "nest build && node --env-file=.env ./dist/cli/seed-menu.js",
    "seed:demo-history": "nest build && node --env-file=.env ./dist/cli/seed-demo-history.js",
    "openapi:export": "pnpm --filter @bar/contracts build && nest build && node --experimental-strip-types ./scripts/openapi-export.ts",
    "openapi:check": "pnpm openapi:export && git diff --exit-code -- ../../docs/api/openapi.json"
  },
  "dependencies": {
    "@bar/contracts": "workspace:*",
    "@nestjs-cls/transactional": "^3.3.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^1.4.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12",
    "@socket.io/redis-adapter": "^8",
    "bullmq": "6.3.11",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "nestjs-cls": "^6.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4",
    "typeorm": "^1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
