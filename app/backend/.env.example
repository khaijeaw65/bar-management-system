NODE_ENV=local
PORT=3001
# OpenAPI UI at /api/docs. true locally and on staging; false in production.
OPENAPI_ENABLED=true
PGHOST=localhost
PGPORT=5432
PGUSER=bar
PGPASSWORD=bar
PGDATABASE=bar
REDIS_URL=redis://localhost:6379
# At least 32 characters. This value is a local placeholder, not a real secret.
JWT_ACCESS_SECRET=replace-me-with-a-local-secret-32ch
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
LINE_CHANNEL_ID=replace-me
LINE_CHANNEL_SECRET=replace-me
LINE_CALLBACK_URL=http://localhost:3001/api/auth/line/callback
FRONTEND_URL=http://localhost:3000
