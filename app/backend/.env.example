NODE_ENV=local
PORT=3001
# OpenAPI UI at /api/docs. true locally and on staging; false in production.
OPENAPI_ENABLED=true
PGHOST=localhost
PGPORT=5432
PGUSER=bar
PGPASSWORD=bar
PGDATABASE=bar
REDIS_URL=redis://localhost:6379
# At least 32 characters. This value is a local placeholder, not a real secret.
JWT_ACCESS_SECRET=replace-me-with-a-local-secret-32ch
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
LINE_CHANNEL_ID=replace-me
LINE_CHANNEL_SECRET=replace-me
# Public LINE callback. A phone on another network uses the tunnel URL — see "Phone & webhooks via tunnel" in README.md.
LINE_CALLBACK_URL=http://localhost:3001/api/auth/line/callback
# Sliding refresh lifetime for Expo staff sessions. Web stays on REFRESH_TTL_DAYS.
MOBILE_REFRESH_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000
# Pending PromptPay QR lifetime. Default 900 (15 minutes) when unset.
PAYMENT_QR_TTL_SECONDS=900
# EasySlip slip verification (BRIEF-025). Leave the key empty until Field registers the bar account:
# the app still boots, and verify-slip answers 503. Default base URL is the v2 API when unset.
EASYSLIP_API_KEY=
EASYSLIP_BASE_URL=https://api.easyslip.com/v2
# Menu photos (S3, DR-020). Region + bucket are required. The access keys are for local dev only —
# leave them empty on ECS, where the task role is used.
AWS_REGION=ap-southeast-1
S3_BUCKET=replace-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
