{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    // temporary — removed by BRIEF-003 (DR-006)
    "src/common/base/base.entity.ts",
    "src/common/subscribers/audit.subscriber.ts",
    "src/common/interceptors/cls-user.interceptor.ts",
    "src/modules/auth"
  ]
}
